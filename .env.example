PORT=3141
SIGIL_DB_PATH=api/db/sigil.db
PUBLIC_BASE_URL=https://sigilprotocol.xyz
CORS_ORIGINS=https://sigilprotocol.xyz,https://www.sigilprotocol.xyz

SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Canonical token + protocol addresses
# Required for production-ready status and truthful /api/readiness checks.
SIGIL_MINT=
SIGIL_STAKING_PROGRAM_ID=
SIGIL_PASSPORT_COLLECTION=

# Passport options
SIGIL_PASSPORT_SYMBOL=SIGIL
SIGIL_ALLOW_LEGACY_PASSPORT_ISSUE=false

# Staking controls
STAKE_COOLDOWN_DAYS=7
EMERGENCY_SLASH_BPS=1000
MIN_STAKE=1000
MAX_STAKE=50000

# Action challenge controls
ACTION_CHALLENGE_TTL_MS=300000

# Enable real on-chain SPL token staking flow
SIGIL_STAKING_ONCHAIN=false
SIGIL_STAKING_TOKEN_PROGRAM=token
SIGIL_STAKING_VAULT_OWNER=

# Required for complete/emergency unstake payouts in on-chain mode.
# Accepted formats:
# - base58 secret key
# - JSON array secret key bytes
SIGIL_STAKING_AUTHORITY_SECRET=
